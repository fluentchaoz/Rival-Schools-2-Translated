        [
          8196,
          [
            17
          ]
        ]
      ]
    },
    {
      "selector": 0,
      "index": 85,
      "source_payload_sha256": "3983fa33d259d9a36c5da4f1f774e588707e5cf294ce7d709943a19104ea0b5f",
      "text": "IF YOU WANNA FIGHT\nTHE BOSS, YOU GOTTA\nFIGHT ME FIRST.",
      "controls": []
    },
    {
      "selector": 0,
      "index": 86,
      "source_payload_sha256": "1e98c493d4abb27a6539e832ff5f9d2dbcaa1d0de21ec3727725c1a840b198e6",
      "text": "SPAR WITH DAIGO\nSPAR WITH EDGE\nDECLINE BOTH",
      "controls": []
    },
    {
      "selector": 0,
      "index": 87,
      "source_payload_sha256": "4a3f2703e6498352d3a4141cc9b65a1a01e0ebd018f34e5bd4738ce65a2634c8",
      "text": "ALL RIGHT, THEN.\nDAIGO, PLEASE\nSPAR WITH ME!",
      "controls": []
