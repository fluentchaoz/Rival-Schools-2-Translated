      "selector": 0,
      "index": 90,
      "source_payload_sha256": "041036aefc69b4fe661e39bf800f1a754950b014857541b7f55776a762c12c46",
      "text": "HAAH! TAKE THAT!\n{0}...\n{1}WHAM! THUD!",
