    {
      "selector": 0,
      "index": 95,
      "source_payload_sha256": "9bc551626ddddcadc7ee4695d29aabc99cc33bbc55acf0aa54ef5be43ff04d4f",
      "text": "TRAIN AT SCHOOL\nOR WITH YOUR CLUB.\nUSE IT ALL TO BETTER\nYOURSELF. GOOD LUCK!",
