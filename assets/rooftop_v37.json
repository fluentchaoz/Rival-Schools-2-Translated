    {
      "selector": 0,
      "index": 88,
      "source_payload_sha256": "458103a0f9d21b99df86e229ad5ea19f8a8d1438b102debda51ced370f79dd69",
      "text": "OH, YOU'LL TAKE\nME ON?\nYOU'VE GOT GUTS!",
      "controls": []
    },
    {
      "selector": 0,
      "index": 89,
      "source_payload_sha256": "30022f82de8b2f79ea89f5a1a09874eef5a26638970a8ce288278a62de889fd7",
      "text": "HEH, INDEED.\nI'LL REWARD YOUR\nCOURAGE. COME AT ME!",
      "controls": []
