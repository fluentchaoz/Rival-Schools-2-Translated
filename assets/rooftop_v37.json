      "selector": 0,
      "index": 94,
      "source_payload_sha256": "d051ee2fec2b2432a43a7ccdbd0fa6cf031f3420c61aca5b15744d3957a981d1",
      "text": "NOW IT'S UP TO YOU.\nA YEAR OF SERIOUS\nTRAINING COULD EVEN\nLET YOU SURPASS ME.",
